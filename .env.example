SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# After ./scripts/start-ngrok.sh, ngrok URLs are written here automatically:
#   NGROK_PUBLIC_URL, API_BASE_URL  (used by the Flutter build)
# VITE_* stays on localhost so the Docker web UI keeps talking to the backend.
# ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS also get the ngrok host/origin appended.
NGROK_PUBLIC_URL=
API_BASE_URL=
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

DB_NAME=call_db
DB_USER=admin
DB_PASSWORD=admin123
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local dev: AI runs on the host (celery_worker uses :8001 via docker-compose.yml).
# Production: remote-deploy.sh sets http://ai_service:9000/analyze-call for web;
# celery_worker prod override uses http://127.0.0.1:44781/analyze-call (host network).
AI_SERVICE_URL=http://127.0.0.1:8001/analyze-call
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=120

# AI service — optional LLM refinement (main_issue, summary, followup_reason, meta_intent)
# Set on the machine running ai_service (uvicorn), not only Django.
HUGGINGFACE_TOKEN=
ENABLE_LLM_REFINEMENT=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_REFINEMENT_MODE=all
# LLM_REFINEMENT_MODE=conditional  → only high priority, needs_followup, or confidence < 0.6

# Scheduled reports (Celery Beat) — daily + weekly drafts for QA review
AUTO_REPORT_ENABLED=True
AUTO_REPORT_USERNAME=
REPORT_DAILY_HOUR=6
REPORT_DAILY_MINUTE=0
REPORT_WEEKLY_DAY=1
REPORT_WEEKLY_HOUR=6
REPORT_WEEKLY_MINUTE=0
CELERY_TIMEZONE=UTC
